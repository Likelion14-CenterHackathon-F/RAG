# Copy to .env and fill in. Never commit real values.

# Azure PostgreSQL with pgvector
DATABASE_URL=postgresql://host:5432/dbname?sslmode=require
DATABASE_USERNAME=
DATABASE_PASSWORD=

# Retrieval
RAG_INDEX_VERSION=2026-08-15-expanded-corpus
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.50

# Restricts retrieval to the 90-document default patient-answer index.
# These are the values ingestion assigned: curated 17, official_rag_candidate 15,
# trusted_rag_candidate 58. Dropping `curated` makes the reviewed answer_template
# documents unreachable, which is exactly what happened before verification.
# Widening the list would let the expanded reference corpus and the evaluation
# holdout ground patient answers.
RAG_ALLOWED_RETRIEVAL_USE=curated,official_rag_candidate,trusted_rag_candidate
RAG_ALLOW_NULL_RETRIEVAL_USE=false

# Embedding. Changing this invalidates the stored vectors: re-ingest first and
# record the comparison against the previous baseline.
KURE_MODEL=nlpai-lab/KURE-v1

# Generation
# gpt-5.6-terra was measured at a 25s tail on the same evidence payload, which
# breaks the 10s response budget. gpt-5.6-luna answered the same prompts in
# 4.2-6.9s across runs with the safety structure intact, so it is the default.
# Keep 900 output tokens: at 600 an answer was cut before the "의료진 진료를
# 대체하지 않는다" closing sentence the developer prompt requires.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_MODEL=gpt-5.6-luna
OPENAI_MAX_OUTPUT_TOKENS=900

# Leave at the default. The rulebook is baked into the image alongside the
# matcher that implements its contract.
# RAG_RULEBOOK_ROOT=/app/rag_rulebook
